{% macro dsl_val(v) %}{% if v is string and "@@{" in v %}"{{v}}"{% else %}{{v}}{% endif %}{% endmacro %}
{% macro ahv_vm_resources(obj) %}
class {{obj.name}}(AhvVmResources):

    memory = {{dsl_val(obj.memory)|trim}}
    vCPUs = {{dsl_val(obj.vCPUs)|trim}}
    cores_per_vCPU = {{dsl_val(obj.cores_per_vCPU)|trim}}
    {% if obj.disks %}disks = [{{obj.disks}}]{% endif %}
    {% if obj.nics %}nics = [{{obj.nics}}]{% endif %}
    {% if obj.gpus %}gpus = [{{obj.gpus}}]{% endif %}
    {% if obj.guest_customization %}guest_customization = {{obj.guest_customization}}{% endif %}
    {% if obj.serial_ports %}serial_ports = {{obj.serial_ports}}{% endif %}
    {% if obj.power_state %}power_state = "{{obj.power_state}}"{% endif %}
    {% if obj.boot_type %}boot_type = "{{obj.boot_type}}"{% endif %}
    {% if obj.vtpm_enabled %}vtpm_enabled = {{obj.vtpm_enabled}}{% endif %}
{% endmacro %}

{{ ahv_vm_resources(obj) }}
